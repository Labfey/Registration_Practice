4. Update src/App.jsx to gate the CRUD behind login
jsx
import { useState, useEffect } from "react";
import axios from "axios";
import Login from "./components/Login";
import Register from "./components/Register";
import StudentForm from "./components/StudentForm";
import StudentTable from "./components/StudentTable";
import "./App.css";

const API_URL = "http://localhost/crud-api";

function App() {
  const [user, setUser] = useState(null);
  const [authView, setAuthView] = useState("login"); // "login" or "register"
  const [checkingSession, setCheckingSession] = useState(true);

  const [students, setStudents] = useState([]);
  const [editingStudent, setEditingStudent] = useState(null);
  const [loading, setLoading] = useState(true);

  // Check if a session already exists on page load
  useEffect(() => {
    axios.get(`${API_URL}/check_session.php`, { withCredentials: true })
      .then((res) => {
        if (res.data.loggedIn) setUser(res.data.user);
      })
      .finally(() => setCheckingSession(false));
  }, []);

  const fetchStudents = async () => {
    try {
      setLoading(true);
      const res = await axios.get(`${API_URL}/read.php`, { withCredentials: true });
      setStudents(res.data);
    } catch (err) {
      console.error("Error fetching students:", err);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (user) fetchStudents();
  }, [user]);

  const handleSave = async (formData, id) => {
    try {
      if (id) {
        await axios.put(`${API_URL}/update.php`, { ...formData, id }, { withCredentials: true });
      } else {
        await axios.post(`${API_URL}/create.php`, formData, { withCredentials: true });
      }
      setEditingStudent(null);
      fetchStudents();
    } catch (err) {
      console.error("Error saving student:", err);
    }
  };

  const handleDelete = async (id) => {
    if (!window.confirm("Are you sure you want to delete this record?")) return;
    try {
      await axios.delete(`${API_URL}/delete.php`, { data: { id }, withCredentials: true });
      fetchStudents();
    } catch (err) {
      console.error("Error deleting student:", err);
    }
  };

  const handleLogout = async () => {
    await axios.post(`${API_URL}/logout.php`, {}, { withCredentials: true });
    setUser(null);
    setStudents([]);
  };

  if (checkingSession) return <p>Loading...</p>;

  // Not logged in -> show login/register
  if (!user) {
    return (
      <div className="app-container">
        {authView === "login" ? (
          <Login onLoginSuccess={setUser} switchToRegister={() => setAuthView("register")} />
        ) : (
          <Register switchToLogin={() => setAuthView("login")} />
        )}
      </div>
    );
  }

  // Logged in -> show CRUD app
  return (
    <div className="app-container">
      <div className="header-bar">
        <h1>Student Records (CRUD)</h1>
        <div>
          <span>Welcome, {user.username}</span>
          <button onClick={handleLogout}>Logout</button>
        </div>
      </div>

      <StudentForm
        onSave={handleSave}
        editingStudent={editingStudent}
        onCancelEdit={() => setEditingStudent(null)}
      />

      <hr />

      {loading ? <p>Loading...</p> : (
        <StudentTable
          students={students}
          onEdit={setEditingStudent}
          onDelete={handleDelete}
        />
      )}
    </div>
  );
}

export default App;
