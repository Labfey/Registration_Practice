import { useState, useEffect } from "react";

function StudentForm({ onSave, editingStudent, onCancelEdit }) {
  const [form, setForm] = useState({ name: "", course: "", year_level: "" });

  // When a student is selected for editing, populate the form
  useEffect(() => {
    if (editingStudent) {
      setForm({
        name: editingStudent.name,
        course: editingStudent.course,
        year_level: editingStudent.year_level,
      });
    } else {
      setForm({ name: "", course: "", year_level: "" });
    }
  }, [editingStudent]);

  const handleChange = (e) => {
    setForm({ ...form, [e.target.name]: e.target.value });
  };

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!form.name || !form.course || !form.year_level) {
      alert("Please fill out all fields.");
      return;
    }
    onSave(form, editingStudent ? editingStudent.id : null);
    setForm({ name: "", course: "", year_level: "" });
  };

  return (
    <form onSubmit={handleSubmit} className="student-form">
      <h2>{editingStudent ? "Edit Student" : "Add Student"}</h2>

      <input
        type="text"
        name="name"
        placeholder="Full Name"
        value={form.name}
        onChange={handleChange}
      />

      <input
        type="text"
        name="course"
        placeholder="Course"
        value={form.course}
        onChange={handleChange}
      />

      <select name="year_level" value={form.year_level} onChange={handleChange}>
        <option value="">-- Select Year Level --</option>
        <option value="1st Year">1st Year</option>
        <option value="2nd Year">2nd Year</option>
        <option value="3rd Year">3rd Year</option>
        <option value="4th Year">4th Year</option>
      </select>

      <div className="form-buttons">
        <button type="submit">{editingStudent ? "Update" : "Add"} Student</button>
        {editingStudent && (
          <button type="button" onClick={onCancelEdit}>
            Cancel
          </button>
        )}
      </div>
    </form>
  );
}

export default StudentForm;
