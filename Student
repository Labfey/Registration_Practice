Complete CRUD Tutorial: React.js + PHP/MySQL (XAMPP)

This tutorial builds a simple Student Records manager. You'll practice the exact skills tested in NC III Web Development: connecting a frontend to a database-driven API, and performing full CRUD operations.

Overview of What You're Building
Database: MySQL table students (id, name, course, year_level)
Backend: PHP REST-style API (no framework — pure PHP + MySQLi)
Frontend: React app that calls the API with fetch/axios
Part 1: Database Setup
Start Apache and MySQL in the XAMPP Control Panel.
Open http://localhost/phpmyadmin
Click New, create a database called crud_db
Click the SQL tab and run:
sql
CREATE DATABASE IF NOT EXISTS crud_db;
USE crud_db;

CREATE TABLE students (
    id INT(11) AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    course VARCHAR(100) NOT NULL,
    year_level VARCHAR(20) NOT NULL,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Optional sample data
INSERT INTO students (name, course, year_level) VALUES
('Juan Dela Cruz', 'BS Information Technology', '3rd Year'),
('Maria Santos', 'BS Computer Science', '2nd Year');
Part 2: Backend (PHP API)
Folder location

Inside your XAMPP installation, go to:

C:\xampp\htdocs\

Create a new folder called crud-api, so the full path is:

C:\xampp\htdocs\crud-api\

Inside crud-api, create these files:

crud-api/
├── db.php
├── create.php
├── read.php
├── update.php
└── delete.php
1. db.php — Database connection
php
<?php
header("Access-Control-Allow-Origin: *");
header("Content-Type: application/json; charset=UTF-8");
header("Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type");

// Handle preflight requests from the browser
if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    http_response_code(200);
    exit();
}

$host = "localhost";
$user = "root";
$pass = "";        // default XAMPP MySQL password is blank
$dbname = "crud_db";

$conn = new mysqli($host, $user, $pass, $dbname);

if ($conn->connect_error) {
    http_response_code(500);
    die(json_encode(["message" => "Connection failed: " . $conn->connect_error]));
}
?>
2. create.php — Add a new student
php
<?php
include 'db.php';

$data = json_decode(file_get_contents("php://input"), true);

if (!empty($data['name']) && !empty($data['course']) && !empty($data['year_level'])) {

    $stmt = $conn->prepare("INSERT INTO students (name, course, year_level) VALUES (?, ?, ?)");
    $stmt->bind_param("sss", $data['name'], $data['course'], $data['year_level']);

    if ($stmt->execute()) {
        http_response_code(201);
        echo json_encode(["message" => "Student created successfully", "id" => $conn->insert_id]);
    } else {
        http_response_code(500);
        echo json_encode(["message" => "Error creating student: " . $stmt->error]);
    }

    $stmt->close();
} else {
    http_response_code(400);
    echo json_encode(["message" => "Incomplete data. Name, course, and year_level are required."]);
}

$conn->close();
?>
3. read.php — Get all students
php
<?php
include 'db.php';

$sql = "SELECT id, name, course, year_level, created_at FROM students ORDER BY id DESC";
$result = $conn->query($sql);

$students = [];

if ($result->num_rows > 0) {
    while ($row = $result->fetch_assoc()) {
        $students[] = $row;
    }
}

http_response_code(200);
echo json_encode($students);

$conn->close();
?>
4. update.php — Edit a student
php
<?php
include 'db.php';

$data = json_decode(file_get_contents("php://input"), true);

if (!empty($data['id']) && !empty($data['name']) && !empty($data['course']) && !empty($data['year_level'])) {

    $stmt = $conn->prepare("UPDATE students SET name = ?, course = ?, year_level = ? WHERE id = ?");
    $stmt->bind_param("sssi", $data['name'], $data['course'], $data['year_level'], $data['id']);

    if ($stmt->execute()) {
        http_response_code(200);
        echo json_encode(["message" => "Student updated successfully"]);
    } else {
        http_response_code(500);
        echo json_encode(["message" => "Error updating student: " . $stmt->error]);
    }

    $stmt->close();
} else {
    http_response_code(400);
    echo json_encode(["message" => "Incomplete data."]);
}

$conn->close();
?>
5. delete.php — Remove a student
php
<?php
include 'db.php';

$data = json_decode(file_get_contents("php://input"), true);

if (!empty($data['id'])) {

    $stmt = $conn->prepare("DELETE FROM students WHERE id = ?");
    $stmt->bind_param("i", $data['id']);

    if ($stmt->execute()) {
        http_response_code(200);
        echo json_encode(["message" => "Student deleted successfully"]);
    } else {
        http_response_code(500);
        echo json_encode(["message" => "Error deleting student: " . $stmt->error]);
    }

    $stmt->close();
} else {
    http_response_code(400);
    echo json_encode(["message" => "ID is required."]);
}

$conn->close();
?>
